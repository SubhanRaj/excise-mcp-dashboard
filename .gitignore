# secrets
**/.env
*.env
!*.env.example
*.pem
*credentials*.json
*service-account*.json

# python
**/.venv/
**/__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/

# laravel (web/)
# Runtime dirs, app keys, and the local .env are ignored in-tree: web/.gitignore
# plus Laravel's per-directory storage/**/.gitignore and bootstrap/cache/.gitignore
# keep the folder skeleton while dropping their contents. A blanket web/storage/
# rule here would also drop those structure files and break a fresh clone.
web/vendor/
web/node_modules/

# scratch / artifacts
/var/tmp/excise-charts/
*.parquet
