# Copy to .env (600 perms), fill in the ro_pw set in db/roles.sql and a shared
# bearer token (also put in web/.env as ORCH_BEARER_TOKEN once web/ exists).
ORCH_BEARER_TOKEN=CHANGE_ME_shared_secret
DATABASE_URL_READONLY=postgresql://excise_ro:CHANGE_ME_ro@127.0.0.1:5432/excise_bank

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_SQL_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_CHAT_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_ALLOWED_MODELS=qwen2.5-coder:7b-instruct-q4_K_M,llama3.1:8b-instruct-q4_K_M

# True once `systemd-run --user --uid=excise-sandbox ...` actually works from
# this account — `loginctl enable-linger excise-sandbox` alone isn't enough
# (confirmed live: still "Operation not permitted" on the GID change), the
# sudoers fallback in SECURITY.md §2 / OPERATOR_SETUP.md §Sandbox execution
# route is the untried real path. False runs the sandboxed script as the
# orchestrator's own user instead — bwrap's own confinement still fully
# applies (SECURITY.md §2), this only skips the host-uid-separation layer.
SANDBOX_UID_SWITCH_ENABLED=false
