APP_NAME="Excise Data Visualization"
APP_ENV=local
APP_KEY=
APP_DEBUG=true              # PRODUCTION: must be 'false' — true leaks stack traces, .env values, SQL
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev uses MariaDB. `php artisan db:provision` fills DB_DATABASE /
# DB_USERNAME / DB_PASSWORD with a scoped, non-root user named the same as the
# database: excise_mcp_dashboard_local. web/ never connects to PostgreSQL — the
# excise data bank is the orchestrator's, read-only.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=excise_mcp_dashboard_local
DB_USERNAME=excise_mcp_dashboard_local
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=10080         # 7 days, sliding — resets on activity, expires after 7 days idle
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false          # PRODUCTION: must be 'true' — the session table holds the login OTP
SESSION_SECURE_COOKIE=false    # PRODUCTION (HTTPS): must be 'true' — stops the cookie over plain HTTP
SESSION_SAME_SITE=strict       # internal tool, no cross-site entry point — keep 'strict'
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: MAIL_MAILER=log writes the login OTP to storage/logs/laravel.log.
# Production: system/auth mail (invite links, login OTP) goes through Resend on a
# verified sending domain — set MAIL_MAILER=resend and RESEND_API_KEY.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@exciseup.in"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# FastAPI orchestrator (MCP client, SQL + retrieval + streaming chat). Bound to
# loopback on the AIO, never tunneled. ORCHESTRATOR_TOKEN is the shared bearer
# token — set it in the real .env at 600 perms, never commit it.
ORCHESTRATOR_BASE_URL=http://127.0.0.1:8085
ORCHESTRATOR_TOKEN=

# Google OAuth (Drive / Sheets / Docs connect, per-user). Client id/secret from
# the Google Cloud console — see OPERATOR_SETUP.md §Google Cloud. Refresh tokens
# are Crypt-encrypted per user, never logged.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://visualizer.exciseup.in/google/callback
